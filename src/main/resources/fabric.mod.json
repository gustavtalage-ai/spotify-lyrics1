{
  "schemaVersion": 1,
  "id": "spotifylyrics",
  "version": "${version}",
  "name": "Alpha Mod",
  "description": "Alpha Mod: PvP-Module, Fadenkreuz-Editor, Bauen, Makros, Soundboard, Texture Packs, Auktionen, Skin wechseln und Spotify-Lyrics.",
  "authors": [
    "gustavtalage"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.example.spotifylyrics.SpotifyLyricsClient"
    ],
    "voicechat": [
      "com.example.spotifylyrics.SoundboardPlugin"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.10",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "voicechat": "*"
  },
  "mixins": [
    "spotifylyrics.mixins.json"
  ],
  "contact": {
    "homepage": "https://github.com/gustavtalage-ai/spotify-lyrics1",
    "sources": "https://github.com/gustavtalage-ai/spotify-lyrics1"
  },
  "custom": {},
  "icon": "assets/spotifylyrics/icon.png"
}
